# StudentHub Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Get your connection string from https://console.neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/studyhub"

# =============================================================================
# NEXTAUTH
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# =============================================================================
# FILE STORAGE (Local for development)
# =============================================================================
# For local development, files are stored in the /uploads directory
# For production, switch to Cloudflare R2 or AWS S3
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./uploads"

# For Cloudflare R2 (production):
# STORAGE_TYPE="r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# =============================================================================
# FILE LIMITS
# =============================================================================
MAX_FILE_SIZE_MB=25
MAX_USER_STORAGE_GB=2

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudentHub"
